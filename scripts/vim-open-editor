#!/usr/bin/env lua
-- scripts/vim-open-editor.lua
-- HyprVim Open Editor - Edit text anywhere in Wayland with vim/nvim

local TERM_CLASS = "hyprvim-open-vim"

-- Load hyprvim.* modules from this script's real location.
do
  local p = io.popen("readlink -f '" .. (arg[0] or ""):gsub("'", "'\\''") .. "' 2>/dev/null")
  local path = p and p:read("*a"):gsub("%s+$", "") or ""
  if p then p:close() end
  local root = path:match("^(.*)/scripts/[^/]+$")
  if root then dofile(root .. "/loader.lua") end
end

local ok_utils, Utils = pcall(require, "hyprvim.lib.utils")
if not ok_utils then
  io.stderr:write("Error: cannot locate hyprvim lib/ modules\n")
  os.exit(1)
end

local sq = Utils.sh_escape

--- Runtime configuration populated by CLI argument parsing.
--- @class Cfg
--- @field copy_sel boolean Pre-fill the scratch file with the current selection
--- @field insert_mode boolean Open the editor in INSERT mode at end-of-content
--- @field in_terminal boolean Active window is a terminal (uses Ctrl+Shift+C to copy)
--- @field ext string|nil File extension for the scratch file (e.g. "md")
--- @field terminal string Terminal emulator binary name
--- @field editor string Editor binary name ("vim" or "nvim")
--- @field tmpdir string Directory for scratch files

--- @type Cfg
local cfg = {
  copy_sel = false,
  insert_mode = false,
  in_terminal = false,
  ext = nil,
  terminal = os.getenv("TERMINAL") or "",
  editor = os.getenv("EDITOR") or "nvim",
  tmpdir = (os.getenv("XDG_CACHE_HOME") or (os.getenv("HOME") .. "/.cache")) .. "/hyprvim/open-vim",
}

--- Run a shell command and return its stdout with trailing whitespace stripped.
--- Stderr is suppressed.
--- @param cmd string
--- @return string
local function pread(cmd)
  local p = io.popen(cmd .. " 2>/dev/null")
  if not p then return "" end
  local s = p:read("*a"):gsub("%s+$", "")
  p:close()
  return s
end

--- Run a shell command, discarding output.
--- @param cmd string
local function run(cmd) os.execute(cmd) end

--- Send a shortcut to the active window via hyprctl dispatch.
--- @param mods string  e.g. "CTRL" or "CTRL SHIFT"
--- @param key string   e.g. "C", "V"
local function send_shortcut(mods, key)
  run(
    string.format(
      "hyprctl dispatch 'hl.dsp.send_shortcut({mods=[[%s]],key=[[%s]],window=[[activewindow]]})'",
      mods,
      key
    )
  )
end

--- Print an error to stderr and exit with code 1.
--- @param msg string
local function die(msg)
  io.stderr:write("Error: " .. msg .. "\n")
  os.exit(1)
end

--- Return true if `name` is an executable available on PATH.
--- @param name string
--- @return boolean
local function cmd_exists(name) return pread("command -v " .. sq(name)) ~= "" end

--- Print `text` followed by a blank line.
--- @param text string
local function print_br(text)
  print(text)
  print("")
end

--- Print usage information and exit.
local function show_help()
  print_br("hyprvim-open-vim <OPTIONS>")
  print_br("Editor: " .. cfg.editor .. " (set via $EDITOR, defaults to nvim)")
  print_br("-e, --ext <ext>\n  Set file extension for the scratch file (e.g. --ext md).")
  print_br("-s, --copy-selected\n  Copy the currently selected text and start editing it.")
  print_br("-i, --insert-mode\n  Start the editor in INSERT mode at end-of-content.")
  print_br("-t, --term <terminal>\n  Terminal emulator to use (uses $TERMINAL if not specified).")
  print_br("-E, --editor <editor>\n  Editor to launch (vim or nvim).")
  print_br("-T, --terminal\n  Hint that the focused window is a terminal (uses Ctrl+Shift+C to copy).")
  os.exit(0)
end

--- Parse `arg` into `cfg`. Exits on unknown flags or missing values.
local function parse_args()
  local i = 1
  while i <= #arg do
    local a = arg[i]
    if a == "--help" or a == "-h" then
      show_help()
    elseif a == "--copy-selected" or a == "-s" then
      cfg.copy_sel = true
    elseif a == "--insert-mode" or a == "-i" then
      cfg.insert_mode = true
    elseif a == "--terminal" or a == "-T" then
      cfg.in_terminal = true
    elseif a == "--ext" or a == "-e" then
      i = i + 1
      if not arg[i] or arg[i]:sub(1, 1) == "-" then die(a .. " requires a value") end
      cfg.ext = arg[i]
    elseif a == "--term" or a == "-t" then
      i = i + 1
      if not arg[i] or arg[i]:sub(1, 1) == "-" then die(a .. " requires a value") end
      cfg.terminal = arg[i]
    elseif a == "--editor" or a == "-E" then
      i = i + 1
      if not arg[i] or arg[i]:sub(1, 1) == "-" then die(a .. " requires a value") end
      cfg.editor = arg[i]
    else
      io.stderr:write("Unknown argument: " .. a .. "\n")
      show_help()
    end
    i = i + 1
  end
end

--- Close any existing hyprvim-open-vim window via hyprctl, then exit.
--- Using hyprctl avoids the self-match problem that pgrep has when called
--- through a `sh -c` wrapper whose argv contains the search pattern.
local function kill_existing()
  local clients = pread("hyprctl clients -j")
  if not clients:match('"class"%s*:%s*"' .. TERM_CLASS .. '"') then return end
  print("An existing instance was found and terminated.")
  run("hyprctl dispatch closewindow class:" .. TERM_CLASS)
  os.exit(1)
end

--- Verify that all required external commands are installed: editor, wl-paste, wl-copy.
local function check_deps()
  for _, dep in ipairs({ cfg.editor, "wl-paste", "wl-copy" }) do
    if not cmd_exists(dep) then die("'" .. dep .. "' is required but not installed.") end
  end
end

--- Create a timestamped scratch file in `cfg.tmpdir` with restricted permissions.
--- Appends `cfg.ext` to the filename if set.
--- @return string  Absolute path to the new file
local function create_tmpfile()
  run("mkdir -p " .. sq(cfg.tmpdir))
  local name = "doc-" .. os.date("%y%m%d%H%M%S")
  if cfg.ext and cfg.ext ~= "" then name = name .. "." .. cfg.ext end
  local path = cfg.tmpdir .. "/" .. name
  local f = io.open(path, "w")
  if not f then die("Could not create tmpfile: " .. path) end
  ---@cast f file*
  f:close()
  run("chmod og-rwx " .. sq(path))
  return path
end

--- Return the Unix mtime of `path` with sub-second precision, or 0 on failure.
--- @param path string
--- @return number
local function get_mtime(path) return tonumber(pread("stat -c %.Y " .. sq(path))) or 0 end

--- Write `content` to wl-copy's stdin with optional extra flags (e.g. "-n").
--- @param content string
--- @param flags? string  Extra flags passed to wl-copy
local function wl_write(content, flags)
  local p = io.popen("wl-copy " .. (flags or ""), "w")
  if p then
    p:write(content)
    p:close()
  end
end

--- Pre-fill `tmpfile` with the current selection.
--- Tries the primary selection first (highlight without clipboard side-effects).
--- Falls back to sending Ctrl+C (or Ctrl+Shift+C in terminals) and reading the clipboard.
--- Restores the clipboard to its pre-call state afterwards.
--- @param tmpfile string
local function copy_selected(tmpfile)
  local last_clip = pread("wl-paste --no-newline")
  -- Primary selection (populated by highlight, no clipboard side effects)
  local selected = pread("wl-paste -p --no-newline")

  if selected == "" then
    run("wl-copy --clear")
    if cfg.in_terminal then
      send_shortcut("CTRL SHIFT", "C")
    else
      send_shortcut("CTRL", "C")
    end
    run("sleep 0.3")
    selected = pread("wl-paste --no-newline")
  end

  if selected ~= "" then
    local f = io.open(tmpfile, "w")
    if f then
      f:write(selected)
      f:close()
    end
  end

  if last_clip ~= "" then
    wl_write(last_clip)
  else
    run("wl-copy --clear")
  end
end

--- Build the terminal launch prefix for the configured terminal.
--- @return string  e.g. "kitty --class hyprvim-open-vim -e"
local function build_term_cmd()
  if cfg.terminal == "" then die("No terminal specified. Set $TERMINAL or use --term") end
  local ok, Config = pcall(require, "hyprvim.config")
  if ok then
    Config.setup({ applications = { terminal = cfg.terminal } })
    return Config.term_cmd(TERM_CLASS)
  end
  return cfg.terminal .. " --class " .. TERM_CLASS .. " -e"
end

--- Open `tmpfile` in a floating terminal editor and block until it closes.
--- In insert mode the editor starts at the end of the file (normal! G + startinsert!).
--- In normal mode the editor starts at the beginning (default cursor position).
--- The editor is configured to quit automatically on BufWritePost.
--- @param tmpfile string
local function launch_editor(tmpfile)
  local term = build_term_cmd()
  local autocmd = "+'autocmd BufWritePost <buffer> quit'"
  local cmd = term .. " " .. cfg.editor .. " " .. autocmd
  if cfg.insert_mode then cmd = cmd .. " +'normal! G' +startinsert!" end
  cmd = cmd .. " " .. sq(tmpfile)
  run(cmd)
end

--- Paste the contents of `tmpfile` back to the previously focused window via Ctrl+V.
--- Saves the current clipboard before pasting and restores it afterwards.
--- Does nothing if the file is empty or contains only newlines.
--- @param tmpfile string
local function paste_content(tmpfile)
  local f = io.open(tmpfile, "r")
  if not f then return end
  -- Editors and format-on-save hooks append trailing newlines; so strip them all.
  local text = f:read("*a"):gsub("\n+$", "")
  f:close()

  if text == "" then return end

  local before = pread("wl-paste --no-newline")
  wl_write(text, "-n")
  run("sleep 0.2")
  send_shortcut("CTRL", "V")
  run("sleep 0.1")
  if before ~= "" then wl_write(before, "-n") end
end

--- Entry point: parse args, validate environment, open editor, paste result.
local function main()
  parse_args()
  kill_existing()
  check_deps()

  local tmpfile = create_tmpfile()

  if cfg.copy_sel then copy_selected(tmpfile) end

  local mtime_before = get_mtime(tmpfile)
  launch_editor(tmpfile)
  local mtime_after = get_mtime(tmpfile)

  if mtime_after > mtime_before then paste_content(tmpfile) end

  os.remove(tmpfile)
end

main()
