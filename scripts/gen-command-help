#!/usr/bin/env luajit
-- Regenerate docs/command-help.md from the command tables in vim/commands/command.lua.

local root = arg[0]:match("^(.*)/scripts/[^/]+$") or "."
dofile(root .. "/loader.lua")

hl = setmetatable({ timer = function() end }, { __index = function() return function() end end })
package.preload["hyprvim.hypr"] = function()
  return setmetatable({}, { __index = function() return function() end end })
end
package.preload["hyprvim.lib.callback"] = function() return { register = function() end } end
package.preload["hyprvim.lib.updater"] = function() return { update = function() end } end
package.preload["hyprvim.lib.submap"] = function() return { current = nil } end

require("hyprvim.config").setup({})

local path = root .. "/docs/command-help.md"
local out = assert(io.open(path, "w"))
out:write(require("hyprvim.vim.commands.command").render_help())
out:close()
print("wrote " .. path)
